var birds=[]; for(var bd=0;bd<2;bd++){ birds.push({ x:-50-bd*120, y:40+Math.random()*40, speed:26+Math.random()*10, amp:6+Math.random()*4 }); }
var drops=[];
function spawnRain(rainN){ var count=Math.round(rainN*26); for(var k=0;k<count;k++){ drops.push({ x:Math.random()*cw, y:-10-Math.random()*60, vy:220+Math.random()*140, len:8+Math.random()*10 }); } }

var lastT=performance.now();
function render(now){
  var dt=Math.min(0.05,(now-lastT)/1000); lastT=now;
  sTemp += (tTemp-sTemp)*Math.min(1,dt*1.5); sVwc += (tVwc-sVwc)*Math.min(1,dt*0.8); sRh += (tRh-sRh)*Math.min(1,dt*1.2);
  sCloudCount += (tCloudCount-sCloudCount)*Math.min(1,dt*1.0);
  sCloudSize  += (tCloudSize -sCloudSize )*Math.min(1,dt*1.0);
  sSpeed      += (tSpeed     -sSpeed     )*Math.min(1,dt*1.0);
  var speedMul = 0.5 + sSpeed*1.0; // 0.5x – 1.5x, defaults near 1x

  var hour = idx % 24;
  var dayFactor = clamp01(0.5+0.5*Math.cos((hour-13)*(2*Math.PI/24)));
  var rainN = ACTIVE ? norm(ACTIVE.rain[idx], SOURCE_STATS.rain.min, SOURCE_STATS.rain.max) : 0;

  var dawn=[58,84,133], dusk=[214,140,66];
  var topCol=[ lerp(dawn[0],dusk[0],sTemp), lerp(dawn[1],dusk[1],sTemp), lerp(dawn[2],dusk[2],sTemp) ];
  var botCol=[ lerp(120,238,sTemp), lerp(150,214,sTemp), lerp(190,150,sTemp) ];
  var nightMul=0.25+0.75*dayFactor;
  var grad=ctx.createLinearGradient(0,0,0,ch);
  grad.addColorStop(0,'rgb('+Math.round(topCol[0]*nightMul)+','+Math.round(topCol[1]*nightMul)+','+Math.round(topCol[2]*nightMul*1.05)+')');
  grad.addColorStop(1,'rgb('+Math.round(botCol[0]*nightMul)+','+Math.round(botCol[1]*nightMul)+','+Math.round(botCol[2]*nightMul)+')');
  ctx.fillStyle=grad; ctx.fillRect(0,0,cw,ch);

  if(dayFactor<0.4){ var starAlpha=(0.4-dayFactor)/0.4; for(var s=0;s<stars.length;s++){ var stt=stars[s]; var tw=0.5+0.5*Math.sin(now/500+stt.ph); ctx.fillStyle='rgba(255,255,255,'+(starAlpha*tw*0.9)+')'; ctx.beginPath(); ctx.arc(stt.x,stt.y,stt.r,0,Math.PI*2); ctx.fill(); } }

  var glowCol = dayFactor>0.5 ? '255,244,214' : '210,220,255';
  var glow=ctx.createRadialGradient(cw*0.82,ch*0.2,2,cw*0.82,ch*0.2,75);
  glow.addColorStop(0,'rgba('+glowCol+','+(0.15+dayFactor*0.35)+')'); glow.addColorStop(1,'rgba('+glowCol+',0)');
  ctx.fillStyle=glow; ctx.fillRect(0,0,cw,ch);

  var visibleClouds = Math.max(1, Math.round(1 + sCloudCount*(CLOUD_POOL-1)));
  var cloudSizeMul = 0.5 + sCloudSize*1.3;
  for(var c=0;c<visibleClouds;c++){
    var cl=clouds[c]; cl.x+=cl.speed*dt*speedMul; if(cl.x>cw+80) cl.x=-80;
    var alpha=(0.25+sRh*0.35)*nightMul; ctx.fillStyle='rgba(255,255,255,'+alpha+')';
    var s = cl.baseS*cloudSizeMul;
    for(var p=0;p<4;p++){ ctx.beginPath(); ctx.ellipse(cl.x+p*18*s, cl.y+Math.sin(p)*4, 22*s, 13*s, 0,0,Math.PI*2); ctx.fill(); }
  }

  if(dayFactor>0.4 && rainN<0.1){ for(var bi=0;bi<birds.length;bi++){ var bd=birds[bi]; bd.x+=bd.speed*dt; if(bd.x>cw+40) bd.x=-40; var by=bd.y+Math.sin(now/300+bi)*bd.amp; ctx.strokeStyle='rgba(60,50,50,0.55)'; ctx.lineWidth=1.4; ctx.beginPath(); ctx.moveTo(bd.x-6,by+3); ctx.quadraticCurveTo(bd.x,by-4,bd.x+6,by+3); ctx.stroke(); } }

  var backTint = dayFactor>0.5 ? [126,150,120] : [58,70,78];
  var frontTint = dayFactor>0.5 ? [72,110,66] : [30,44,40];
  drawHill(hillBack, 'rgba('+backTint[0]+','+backTint[1]+','+backTint[2]+',0.75)');
  drawHill(hillFront, 'rgba('+frontTint[0]+','+frontTint[1]+','+frontTint[2]+',0.9)');

  var grassColor=[ lerp(179,42,sVwc), lerp(173,120,sVwc), lerp(92,58,sVwc) ];
  ctx.strokeStyle='rgb('+Math.round(grassColor[0]*nightMul)+','+Math.round(grassColor[1]*nightMul)+','+Math.round(grassColor[2]*nightMul)+')';
  ctx.lineCap='round';
  var sway=6+(drops.length>10?10:0);
  for(var gi=0;gi<blades.length;gi++){ var bl=blades[gi]; var h=bl.baseH*(0.35+0.75*sVwc); var swayX=Math.sin(now/1000*bl.speed*speedMul+bl.phase)*sway; ctx.lineWidth=2.4; ctx.beginPath(); ctx.moveTo(bl.x,ch); ctx.quadraticCurveTo(bl.x+swayX*0.6,ch-h*0.6,bl.x+swayX,ch-h); ctx.stroke(); }

  ctx.strokeStyle='rgba(210,232,255,0.8)'; ctx.lineWidth=1.4;
  for(var ri=drops.length-1;ri>=0;ri--){ var dr=drops[ri]; dr.y+=dr.vy*dt*speedMul; ctx.beginPath(); ctx.moveTo(dr.x,dr.y); ctx.lineTo(dr.x-2,dr.y+dr.len); ctx.stroke(); if(dr.y>ch) drops.splice(ri,1); }
  if(drops.length>240) drops.splice(0,drops.length-240);

  var mistAlpha=sRh*0.22;
  for(var m=0;m<3;m++){ var mg=ctx.createRadialGradient(cw*(0.2+m*0.3)+Math.sin(now/2000+m)*20, ch*0.75, 10, cw*(0.2+m*0.3), ch*0.75, 160); mg.addColorStop(0,'rgba(255,255,255,'+mistAlpha+')'); mg.addColorStop(1,'rgba(255,255,255,0)'); ctx.fillStyle=mg; ctx.fillRect(0,ch*0.45,cw,ch*0.55); }

  drawWires();
  requestAnimationFrame(render);
}
requestAnimationFrame(render);

var TICK_MS=180;
function tick(){
