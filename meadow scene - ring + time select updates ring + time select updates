  readout.textContent = ACTIVE.ts[idx]+'  (point '+(idx+1)+' of '+N+')  |  rain '+ACTIVE.rain[idx].toFixed(2)+'mm  temp '+ACTIVE.temp[idx].toFixed(1)+'°F  RH '+ACTIVE.rh[idx].toFixed(1)+'%  VWC '+ACTIVE.vwc[idx].toFixed(3);
}
