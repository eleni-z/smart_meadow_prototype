// ================= TIME-PERIOD SUBSELECTION =================
// The PICKER only works in whole days (so it's two simple calendar
// pickers, not a fiddly hour/minute entry) — but DATA can be at ANY
// resolution (hourly, 15-minute, whatever you embed). Picking "day"
// granularity never throws away precision: once a day range is chosen,
// every reading DATA actually has for those days is kept and played back,
// however fine-grained it is.
//
// DATA.ts strings are ISO ("YYYY-MM-DDTHH:MM"), which sorts correctly as
// plain text, so a day's boundaries are just that day's date with a time
// appended ("T00:00" / "T23:59") — no real date parsing needed.
var rangeStart = document.getElementById('rangeStart');
var rangeEnd = document.getElementById('rangeEnd');
var rangeStatus = document.getElementById('rangeStatus');
var applyRangeBtn = document.getElementById('applyRangeBtn');

function nearestIndexAtOrAfter(value){
  // first index whose ts >= value
  for(var i=0;i<DATA.ts.length;i++){ if(DATA.ts[i] >= value) return i; }
  return DATA.ts.length-1;
}
function nearestIndexAtOrBefore(value){
  // last index whose ts <= value
  for(var i=DATA.ts.length-1;i>=0;i--){ if(DATA.ts[i] <= value) return i; }
  return 0;
}

var fullStartDay = DATA.ts[0].slice(0,10);           // "YYYY-MM-DD"
var fullEndDay   = DATA.ts[DATA.ts.length-1].slice(0,10);
rangeStart.min = rangeEnd.min = fullStartDay;
rangeStart.max = rangeEnd.max = fullEndDay;
rangeStart.value = fullStartDay;
rangeEnd.value = fullEndDay;

// The native date-picker's own calendar/display follows the browser's
// locale, which is usually mm/dd/yyyy in the US but isn't guaranteed —
// this small text underneath always shows mm/dd/yyyy regardless of that.
var rangeStartDisplay = document.getElementById('rangeStartDisplay');
var rangeEndDisplay = document.getElementById('rangeEndDisplay');
function toMMDDYYYY(isoDay){
  if(!isoDay) return '';
  var parts = isoDay.split('-'); // [yyyy, mm, dd]
  return parts[1] + '/' + parts[2] + '/' + parts[0];
}
function updateDateDisplays(){
  rangeStartDisplay.textContent = toMMDDYYYY(rangeStart.value);
  rangeEndDisplay.textContent = toMMDDYYYY(rangeEnd.value);
}
rangeStart.addEventListener('input', updateDateDisplays);
rangeEnd.addEventListener('input', updateDateDisplays);
updateDateDisplays();

applyRangeBtn.addEventListener('click', function(){
  if(!rangeStart.value || !rangeEnd.value){ rangeStatus.textContent='Pick a start and end day first.'; return; }
  if(rangeStart.value > rangeEnd.value){ rangeStatus.textContent='Start day must be before (or the same as) the end day.'; return; }
  var s = nearestIndexAtOrAfter(rangeStart.value + 'T00:00');
  var e = nearestIndexAtOrBefore(rangeEnd.value + 'T23:59');
  if(e - s < 1){ rangeStatus.textContent='That window has fewer than 2 data points — pick a wider range.'; return; }
  playing=false; clearInterval(intervalId); playBtn.textContent='Play';
  rebuildRange(s, e);
});
rebuildRange(0, DATA.ts.length-1);

// ================= PATCH-CABLE WIRING UI =================
// Sources and targets are freely-draggable nodes (per the project's design
// note: "all elements are movable around the page"). The only wiring
// interaction is dragging a line from one port to another — no dropdowns,
// no auto-connect-by-proximity. Each wired target shows a small percent
// ring instead of a permanent slider, to keep the panel compact; clicking
// the ring toggles a slider popover open or closed.
var SOURCE_DEFS = [
  { key:'rain', label:'Rainfall',        x:16,  y:16  },
  { key:'temp', label:'Air temperature', x:16,  y:76  },
  { key:'rh',   label:'Humidity',        x:16,  y:136 },
  { key:'vwc',  label:'Soil moisture',   x:16,  y:196 }
];
// Each label now pairs the category with the parameter (e.g. "Drone Pitch"
// instead of a bare "Pitch") — with the group headers gone (nodes are
// freely draggable now, so a fixed header can't follow a node around),
// the label itself is the only thing that says what each block controls.
var TARGET_DEFS = [
  { key:'dronePitch',   label:'Drone Pitch',   color:'#3b6fd6', x:250, y:16  },
  { key:'droneTone',    label:'Drone Tone',    color:'#3b6fd6', x:250, y:96  },
  { key:'melodyPitch',  label:'Melody Pitch',  color:'#7a4fd1', x:250, y:176 },
  { key:'melodyVolume', label:'Melody Volume', color:'#7a4fd1', x:250, y:256 },
  { key:'rainSound',    label:'Rain Volume',   color:'#2286c9', x:250, y:336 },
  { key:'cloudCount',   label:'Cloud Count',   color:'#64748b', x:250, y:416 },
  { key:'cloudSize',    label:'Cloud Size',    color:'#64748b', x:490, y:16  },
  { key:'skyColor',     label:'Sky Color',     color:'#d97706', x:490, y:96  },
  { key:'grassGrowth',  label:'Grass Height',  color:'#16a34a', x:490, y:176 },
  { key:'rainVisual',   label:'Rain Drops',    color:'#0ea5e9', x:490, y:256 },
  { key:'atmosphere',   label:'Mist Amount',   color:'#94a3b8', x:490, y:336 },
  { key:'sceneSpeed',   label:'Scene Speed',   color:'#db2777', x:490, y:416 }
];

var wiringPanel = document.getElementById('wiringPanel');
var wiresSvg = document.getElementById('wires');
var nodeEls = {}; // targetKey -> { wrap, port, detail }

function clampPos(x,y,w,h){
  var maxX = wiringPanel.clientWidth - w, maxY = wiringPanel.clientHeight - h;
  return { x: Math.max(0,Math.min(maxX,x)), y: Math.max(0,Math.min(maxY,y)) };
}
// Reusable free-drag: el is the element that moves, handleEl is what you
// grab (defaults to el itself). Clicks on anything matching excludeSel
// (ports, buttons, sliders) never start a drag, so they keep their own
// click/drag behavior.
function makeDraggable(el, handleEl, excludeSel){
  handleEl = handleEl || el;
  handleEl.addEventListener('pointerdown', function(e){
    if(excludeSel && e.target.closest(excludeSel)) return;
    var startX=e.clientX, startY=e.clientY;
    var origLeft=el.offsetLeft, origTop=el.offsetTop;
    el.style.zIndex = 50;
    handleEl.setPointerCapture(e.pointerId);
    function onMove(ev){
      var dx=ev.clientX-startX, dy=ev.clientY-startY;
      var p = clampPos(origLeft+dx, origTop+dy, el.offsetWidth, el.offsetHeight);
      el.style.left = p.x+'px'; el.style.top = p.y+'px';
    }
    function onUp(ev){
      handleEl.removeEventListener('pointermove', onMove);
      handleEl.removeEventListener('pointerup', onUp);
      // Release capture explicitly — otherwise this element keeps
      // intercepting pointer events (even ones that land on a totally
      // different element, like a wire port) until the page is reloaded.
      try{ handleEl.releasePointerCapture(ev.pointerId); }catch(err){}
      el.style.zIndex = el.classList.contains('open') ? 20 : 1;
    }
    handleEl.addEventListener('pointermove', onMove);
    handleEl.addEventListener('pointerup', onUp);
  });
}

function buildSourceNode(def){
  var el = document.createElement('div');
  el.className = 'wnode source-node';
  el.style.left = def.x+'px'; el.style.top = def.y+'px';
  var label = document.createElement('span'); label.textContent = def.label;
  var port = document.createElement('div'); port.className='wport'; port.dataset.kind='source'; port.dataset.id=def.key;
  el.appendChild(label); el.appendChild(port);
  wiringPanel.appendChild(el);
  makeDraggable(el, el, '.wport');
}

// Small SVG ring showing the connection's intensity as a filled arc.
// Fraction = intensity / 1.5, so the default intensity of 1.0 reads as
// about two-thirds full (matches the 0–150% slider range).
function makeRing(frac, color){
  var svgNS='http://www.w3.org/2000/svg';
  var size=22, r=8, c=2*Math.PI*r;
  var svg=document.createElementNS(svgNS,'svg');
  svg.setAttribute('width',size); svg.setAttribute('height',size);
  svg.setAttribute('viewBox','0 0 '+size+' '+size);
  svg.classList.add('ring-btn');
  var bg=document.createElementNS(svgNS,'circle');
  bg.setAttribute('cx',size/2); bg.setAttribute('cy',size/2); bg.setAttribute('r',r);
  bg.setAttribute('fill','none'); bg.setAttribute('stroke','#e2e2e2'); bg.setAttribute('stroke-width','3');
  var fg=document.createElementNS(svgNS,'circle');
  fg.setAttribute('cx',size/2); fg.setAttribute('cy',size/2); fg.setAttribute('r',r);
  fg.setAttribute('fill','none'); fg.setAttribute('stroke',color); fg.setAttribute('stroke-width','3');
  fg.setAttribute('stroke-dasharray', (c*clamp01(frac))+' '+c);
  fg.setAttribute('stroke-linecap','round');
  fg.setAttribute('transform','rotate(-90 '+size/2+' '+size/2+')');
  svg.appendChild(bg); svg.appendChild(fg);
  return svg;
}

function buildTargetNode(def){
  var wrap = document.createElement('div'); wrap.className = 'target-wrap';
  wrap.style.left = def.x+'px'; wrap.style.top = def.y+'px';
  var row = document.createElement('div'); row.className = 'wnode target-node';
  row.style.borderLeft = '4px solid '+def.color;
  var port = document.createElement('div'); port.className='wport'; port.dataset.kind='target'; port.dataset.id=def.key;
  var label = document.createElement('span'); label.textContent = def.label;
  row.appendChild(port); row.appendChild(label);
  wrap.appendChild(row);
  var detail = document.createElement('div'); detail.className='target-detail';
  wrap.appendChild(detail);
  wiringPanel.appendChild(wrap);
  nodeEls[def.key] = { wrap: wrap, port: port, detail: detail };
  makeDraggable(wrap, row, '.wport');
  refreshTargetDetail(def.key);
}

function refreshTargetDetail(key){
  var def = TARGET_DEFS.filter(function(t){ return t.key===key; })[0];
  var info = nodeEls[key];
  var m = mappings[key];
  info.detail.innerHTML = '';
  info.wrap.classList.remove('open');
  if(!m.source){
    return; // unwired — nothing to show under the node
  }
  var srcDef = SOURCE_DEFS.filter(function(s){ return s.key===m.source; })[0];

  // Named so the replacement ring (built whenever the slider moves) can
  // reuse the exact same handler — addEventListener doesn't populate
  // el.onclick, so copying ring.onclick would silently attach nothing.
  function toggleOpen(){
    info.wrap.classList.toggle('open');
    info.wrap.style.zIndex = info.wrap.classList.contains('open') ? 20 : 1;
  }
  var ring = makeRing(m.intensity/1.5, def.color);
  ring.addEventListener('click', toggleOpen);
  info.detail.appendChild(ring);

  var pop = document.createElement('div'); pop.className='popover';
  var top = document.createElement('div'); top.className='popover-top';
  var srcLabel = document.createElement('span'); srcLabel.textContent = '← ' + srcDef.label;

  var icons = document.createElement('span');
  // Green check = keep this intensity and close the box (does NOT unwire).
  var saveBtn = document.createElement('span'); saveBtn.className='icon-btn popover-save'; saveBtn.textContent='✓';
  saveBtn.title = 'Save and close';
  saveBtn.addEventListener('click', function(){
    info.wrap.classList.remove('open'); info.wrap.style.zIndex = 1;
  });
  // Red × = remove the wire entirely (this is the disconnect toggle now).
  var disconnectBtn = document.createElement('span'); disconnectBtn.className='icon-btn popover-disconnect'; disconnectBtn.textContent='×';
  disconnectBtn.title = 'Disconnect';
  disconnectBtn.addEventListener('click', function(){ mappings[key].source=null; refreshTargetDetail(key); });
  icons.appendChild(saveBtn); icons.appendChild(disconnectBtn);

  top.appendChild(srcLabel); top.appendChild(icons);

  var sliderRow = document.createElement('div'); sliderRow.className='slider-row';
  var pct = document.createElement('span'); pct.className='pct-label'; pct.textContent = Math.round(m.intensity*100)+'%';
  var slider = document.createElement('input'); slider.type='range'; slider.min=0; slider.max=150; slider.value=Math.round(m.intensity*100);
  slider.style.accentColor = def.color;
  slider.addEventListener('input', function(){
    mappings[key].intensity = (+slider.value)/100; pct.textContent = slider.value+'%';
    var newRing = makeRing(mappings[key].intensity/1.5, def.color);
    newRing.addEventListener('click', toggleOpen);
    info.detail.replaceChild(newRing, info.detail.firstChild);
  });
  sliderRow.appendChild(slider); sliderRow.appendChild(pct);

  pop.appendChild(top); pop.appendChild(sliderRow);
  info.detail.appendChild(pop);
}

SOURCE_DEFS.forEach(buildSourceNode);
TARGET_DEFS.forEach(buildTargetNode);

function portPos(portEl){
  var r = portEl.getBoundingClientRect(), c = wiringPanel.getBoundingClientRect();
  return { x: r.left + r.width/2 - c.left, y: r.top + r.height/2 - c.top };
}
function allPorts(kind){
  return Array.prototype.slice.call(document.querySelectorAll('.wport[data-kind="'+kind+'"]'));
}
function drawCurve(p1,p2,color,width,opacity,dashed){
  var svgNS='http://www.w3.org/2000/svg';
  var path=document.createElementNS(svgNS,'path');
  var midX=(p1.x+p2.x)/2;
  var d='M '+p1.x+' '+p1.y+' C '+midX+' '+p1.y+', '+midX+' '+p2.y+', '+p2.x+' '+p2.y;
  path.setAttribute('d',d); path.setAttribute('stroke',color); path.setAttribute('stroke-width',width);
  path.setAttribute('fill','none'); path.setAttribute('opacity',opacity);
  if(dashed) path.setAttribute('stroke-dasharray','5,4');
  wiresSvg.appendChild(path);
}
var activeDrag = null;
function drawWires(){
  wiresSvg.setAttribute('width', wiringPanel.clientWidth);
  wiresSvg.setAttribute('height', wiringPanel.clientHeight);
  wiresSvg.innerHTML='';
  TARGET_DEFS.forEach(function(def){
    var m = mappings[def.key];
    if(!m.source) return;
    var srcPort = document.querySelector('.wport[data-kind="source"][data-id="'+m.source+'"]');
    var tgtPort = nodeEls[def.key].port;
    if(!srcPort || !tgtPort) return;
    drawCurve(portPos(srcPort), portPos(tgtPort), def.color, 2.5, 0.85);
  });
  if(activeDrag){
    var el = activeDrag.kind==='source'
      ? document.querySelector('.wport[data-kind="source"][data-id="'+activeDrag.id+'"]')
      : nodeEls[activeDrag.id].port;
    drawCurve(portPos(el), { x: activeDrag.x, y: activeDrag.y }, '#999', 2, 0.6, true);
  }
}

// This is the actual wiring mechanism: pointerdown on any port starts a
// drag; pointerup near an opposite-kind port completes the connection by
// setting mappings[targetKey].source = sourceKey. Nothing else changes —
// getMapped() picks it up on the very next tick, same as every version before.
wiringPanel.addEventListener('pointerdown', function(e){
  var portEl = e.target.closest('.wport');
  if(!portEl) return;
  var panelRect = wiringPanel.getBoundingClientRect();
  activeDrag = { kind: portEl.dataset.kind, id: portEl.dataset.id, x: e.clientX-panelRect.left, y: e.clientY-panelRect.top };
  document.addEventListener('pointermove', onDragMove);
  document.addEventListener('pointerup', onDragEnd);
});
function onDragMove(e){
  if(!activeDrag) return;
  var panelRect = wiringPanel.getBoundingClientRect();
  activeDrag.x = e.clientX-panelRect.left; activeDrag.y = e.clientY-panelRect.top;
}
function onDragEnd(e){
  if(!activeDrag){ cleanupDrag(); return; }
  var panelRect = wiringPanel.getBoundingClientRect();
  var relX = e.clientX-panelRect.left, relY = e.clientY-panelRect.top;
  var oppKind = activeDrag.kind==='source' ? 'target' : 'source';
  var candidates = allPorts(oppKind);
  var best=null, bestD=32;
  candidates.forEach(function(p){
    var pos = portPos(p);
    var d = Math.hypot(pos.x-relX, pos.y-relY);
    if(d<bestD){ bestD=d; best=p; }
  });
  if(best){
    var targetKey = activeDrag.kind==='source' ? best.dataset.id : activeDrag.id;
    var sourceKey = activeDrag.kind==='source' ? activeDrag.id : best.dataset.id;
    mappings[targetKey].source = sourceKey;
    refreshTargetDetail(targetKey);
  }
  cleanupDrag();
}
function cleanupDrag(){
  activeDrag=null;
  document.removeEventListener('pointermove', onDragMove);
  document.removeEventListener('pointerup', onDragEnd);
}

drawWires();
</script>
